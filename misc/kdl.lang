<repository>
    <float_fraction>
        <comment>Floating point literal (fraction)</comment>
        <name>constant.numeric.float.rust</name>
        <match>([0-9\-\+]|\-|\+)[0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?</match>
    </float_fraction>
    <float_exp>
        <comment>Floating point literal (exponent)</comment>
        <name>constant.numeric.float.rust</name>
        <match>[0-9][0-9_]*(\.[0-9][0-9_]*)?[eE][+-]?[0-9_]+</match>
    </float_exp>
    <decimal>
        <comment>Integer literal (decimal)</comment>
        <name>constant.numeric.integer.decimal.rust</name>
        <match>[0-9\-\+][0-9_]*</match>
    </decimal>
    <hexadecimal>
        <comment>Integer literal (hexadecimal)</comment>
        <name>constant.numeric.integer.hexadecimal.rust</name>
        <match>0x[a-fA-F0-9][a-fA-F0-9_]*</match>
    </hexadecimal>
    <octal>
        <comment>Integer literal (octal)</comment>
        <name>constant.numeric.integer.octal.rust</name>
        <match>0o[0-7][0-7_]*</match>
    </octal>
    <binary>
        <comment>Integer literal (binary)</comment>
        <name>constant.numeric.integer.binary.rust</name>
        <match>0b[01][01_]*</match>
    </binary>
    <forbidden_ident>
        <name>invalid.illegal.kdl.bad-ident</name>
